SURVEILX_DATABASE_URL=sqlite:///data/surveilx.db
SURVEILX_DATA_DIR=data
SURVEILX_DEMO=true
SURVEILX_ALLOWED_ORIGIN=http://127.0.0.1:8000
SURVEILX_SECURE_COOKIES=false
# Set a unique password of at least 12 characters before the first run, or leave
# unset to create data/initial-admin-password.txt. Later changes do not reset users.
# SURVEILX_ADMIN_PASSWORD=
SURVEILX_COVERAGE_SECONDS=5
SURVEILX_CONFIRMATION_SECONDS=2
SURVEILX_COOLDOWN_SECONDS=60
SURVEILX_DETECTION_LOG_SECONDS=60
SURVEILX_RETENTION_DAYS=7
# Optional verified isolated training environment; inference uses the app environment.
# SURVEILX_TRAINING_PYTHON=C:/path/to/SurveilX/.venv-cuda/Scripts/python.exe
# SURVEILX_TRAINING_BATCH_SIZE=1
# Optional architecture limits after measuring the actual GPU.
# SURVEILX_TRAINING_YOLO_BATCH_SIZE=8
# SURVEILX_TRAINING_EVENT_BATCH_SIZE=8
# SURVEILX_DETECTOR_PATH=data/models/reviewed-detector.pt
# SURVEILX_S3_BUCKET=surveilx-evidence
# SURVEILX_S3_ENDPOINT=http://127.0.0.1:9000
